<script src="https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.6/dist/umd/ffmpeg.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/umd/index.js"></script>
<script>
const {FFmpeg} = FFmpegWASM;
const {fetchFile, toBlobURL} = FFmpegUtil;

let ffmpeg = null, videoFile = null, videoDuration = 0;
let trimStartRatio = 0, trimEndRatio = 1;
let encodeStartTime = 0, elapsedTimer = null;
let cancelled = false;

// Presets
const PRESETS = {
  'tiktok-v': {res:'1080x1920',crf:18,preset:'medium',fps:'source',tip:'Vertical 1080×1920 at CRF 18 — optimal for TikTok vertical feed. Stays sharp after their re-compression.'},
  'tiktok-h': {res:'1920x1080',crf:18,preset:'medium',fps:'source',tip:'Horizontal 1080×1920 — for TikTok landscape mode. High bitrate source survives re-compression.'},
  'yt-shorts': {res:'1080x1920',crf:16,preset:'slow',fps:'60',tip:'YouTube Shorts — CRF 16 for extra headroom. YouTube\'s VP9 encoder benefits from high-quality H.264 source.'},
  'ig-reels': {res:'1080x1920',crf:18,preset:'medium',fps:'30',tip:'Instagram Reels — 30fps at 1080p. Instagram targets ~3.5 Mbps; starting high keeps your video clean.'},
  'custom': {tip:'Manual mode — configure everything yourself.'}
};

// DOM refs
const dropzone = document.getElementById('dropzone');
const fileInput = document.getElementById('fileInput');
const videoSection = document.getElementById('videoSection');
const videoWrap = document.getElementById('videoWrap');
const videoPlayer = document.getElementById('videoPlayer');
const playOverlay = document.getElementById('playOverlay');
const fileStatus = document.getElementById('fileStatus');
const svDur = document.getElementById('sv-dur');
const svRes = document.getElementById('sv-res');
const svSize = document.getElementById('sv-size');
const svFps = document.getElementById('sv-fps');
const trimTrack = document.getElementById('trimTrack');
const trimFill = document.getElementById('trimFill');
const trimStartEl = document.getElementById('trimStart');
const trimEndEl = document.getElementById('trimEnd');
const trimStartLabel = document.getElementById('trimStartLabel');
const trimEndLabel = document.getElementById('trimEndLabel');
const trimDur = document.getElementById('trimDur');
const encodeBtn = document.getElementById('encodeBtn');
const cancelBtn = document.getElementById('cancelBtn');
const progressArea = document.getElementById('progressArea');
const bar = document.getElementById('bar');
const progLabel = document.getElementById('prog-label');
const progPct = document.getElementById('prog-pct');
const logEl = document.getElementById('log');
const dlLink = document.getElementById('dlLink');
const doneBadge = document.getElementById('doneBadge');
const doneArea = document.getElementById('doneArea');
const origSize = document.getElementById('origSize');
const newSize = document.getElementById('newSize');
const sizeChange = document.getElementById('sizeChange');
const encodeSummary = document.getElementById('encodeSummary');
const elapsedEl = document.getElementById('elapsed');
const encSpeedEl = document.getElementById('encSpeed');
const etaEl = document.getElementById('eta');
const advancedPanel = document.getElementById('advancedPanel');

// Helpers
function fmt(b){if(b>1e9)return(b/1e9).toFixed(2)+' GB';if(b>1e6)return(b/1e6).toFixed(1)+' MB';return(b/1e3).toFixed(0)+' KB'}
function fmtDur(s){const m=Math.floor(s/60),sec=Math.round(s%60);return m+':'+(sec<10?'0':'')+sec}
function fmtDurFull(s){const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=Math.round(s%60);return h>0?h+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0'):m+':'+String(sec).padStart(2,'0')}

// Drop / file
dropzone.addEventListener('dragover',e=>{e.preventDefault();dropzone.classList.add('over')});
dropzone.addEventListener('dragleave',()=>dropzone.classList.remove('over'));
dropzone.addEventListener('drop',e=>{e.preventDefault();dropzone.classList.remove('over');if(e.dataTransfer.files[0])handleFile(e.dataTransfer.files[0])});
fileInput.addEventListener('change',()=>{if(fileInput.files[0])handleFile(fileInput.files[0])});

function handleFile(f){
  videoFile = f;
  fileStatus.textContent = f.name.length>24?f.name.slice(0,22)+'…':f.name;
  svSize.textContent = fmt(f.size);
  videoSection.classList.remove('hidden');
  doneArea.classList.add('hidden');
  progressArea.classList.add('hidden');
  dlLink.classList.add('hidden');
  doneBadge.classList.add('hidden');
  bar.style.width='0';
  bar.classList.remove('done');
  logEl.textContent='';
  encodeBtn.disabled=false;

  const url = URL.createObjectURL(f);
  videoPlayer.src = url;
  videoWrap.style.display='block';
  videoPlayer.onloadedmetadata = ()=>{
    videoDuration = videoPlayer.duration;
    svDur.textContent = fmtDurFull(videoDuration);
    svRes.textContent = videoPlayer.videoWidth+'×'+videoPlayer.videoHeight;
    trimStartRatio=0; trimEndRatio=1;
    updateTrimUI();
    updateEstimate();
    generateWaveform();
  };
}

// Video play
playOverlay.addEventListener('click',()=>{
  if(videoPlayer.paused){videoPlayer.play();playOverlay.style.opacity='0'}
  else{videoPlayer.pause();playOverlay.style.opacity='1'}
});
videoPlayer.addEventListener('click',()=>{
  if(videoPlayer.paused)videoPlayer.play();else videoPlayer.pause();
});

// Trim
function updateTrimUI(){
  const s=trimStartRatio*100, e=(1-trimEndRatio)*100;
  trimFill.style.left=s+'%';
  trimFill.style.right=e+'%';
  trimStartEl.style.left=s+'%';
  trimEndEl.style.right=e+'%';
  const tStart=trimStartRatio*videoDuration;
  const tEnd=trimEndRatio*videoDuration;
  trimStartLabel.textContent=fmtDur(tStart);
  trimEndLabel.textContent=fmtDur(tEnd);
  trimDur.textContent='clip: '+fmtDur(tEnd-tStart);
}

function makeDraggable(el, onMove){
  el.addEventListener('mousedown',e=>{
    e.preventDefault();
    const move=ev=>{
      const rect=trimTrack.getBoundingClientRect();
      const ratio=Math.max(0,Math.min(1,(ev.clientX-rect.left)/rect.width));
      onMove(ratio);
      updateTrimUI();
      updateEstimate();
    };
    const up=()=>{document.removeEventListener('mousemove',move);document.removeEventListener('mouseup',up)};
    document.addEventListener('mousemove',move);
    document.addEventListener('mouseup',up);
  });
  el.addEventListener('touchstart',e=>{
    const move=ev=>{
      const rect=trimTrack.getBoundingClientRect();
      const ratio=Math.max(0,Math.min(1,(ev.touches[0].clientX-rect.left)/rect.width));
      onMove(ratio);
      updateTrimUI();
      updateEstimate();
    };
    const up=()=>{document.removeEventListener('touchmove',move);document.removeEventListener('touchend',up)};
    document.addEventListener('touchmove',move);
    document.addEventListener('touchend',up);
  });
}

makeDraggable(trimStartEl,r=>{trimStartRatio=Math.min(r,trimEndRatio-0.01)});
makeDraggable(trimEndEl,r=>{trimEndRatio=Math.max(r,trimStartRatio+0.01)});

function generateWaveform(){
  const wf=document.getElementById('waveform');
  wf.innerHTML='';
  for(let i=0;i<60;i++){
    const h=Math.max(8,Math.random()*100);
    const d=document.createElement('div');
    d.className='wave-bar';
    d.style.height=h+'%';
    wf.appendChild(d);
  }
}

// Presets
document.querySelectorAll('.preset-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.preset-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const p=PRESETS[btn.dataset.preset];
    if(p.res){
      document.getElementById('res').value=p.res;
      document.getElementById('crfRange').value=p.crf;
      document.getElementById('crfVal').textContent=p.crf;
      document.getElementById('preset').value=p.preset;
      document.getElementById('fps').value=p.fps;
    }
    document.getElementById('presetTip').textContent=p.tip;
    updateEstimate();
  });
});

// Advanced toggle
document.getElementById('toggleAdvanced').addEventListener('click',()=>{
  const show=advancedPanel.classList.toggle('hidden');
  document.getElementById('toggleAdvanced').textContent=show?'+ Advanced':'– Advanced';
});

// Audio/color tabs
document.querySelectorAll('#acTabs .tab').forEach(tab=>{
  tab.addEventListener('click',()=>{
    document.querySelectorAll('#acTabs .tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    ['audio','color','sharpen'].forEach(id=>{
      const el=document.getElementById('ac-'+id);
      if(el)el.classList.toggle('hidden',id!==tab.dataset.ac);
    });
  });
});

// Range displays
function rangeLink(id,outId,suffix=''){
  const el=document.getElementById(id), out=document.getElementById(outId);
  el.addEventListener('input',()=>{out.textContent=el.value+(suffix?suffix:'');updateEstimate()});
}
rangeLink('crfRange','crfVal');
rangeLink('volRange','volVal','%');
rangeLink('brightness','brightnessVal');
rangeLink('contrast','contrastVal');
rangeLink('saturation','saturationVal');
rangeLink('gamma','gammaVal');
rangeLink('hue','hueVal','°');
rangeLink('sharpen','sharpenVal');
rangeLink('denoise','denoiseVal');
document.getElementById('res').addEventListener('change',updateEstimate);
document.getElementById('codec').addEventListener('change',updateEstimate);
document.getElementById('abitrate').addEventListener('change',updateEstimate);

function resetColor(){
  ['brightness','contrast','hue'].forEach(id=>{document.getElementById(id).value=0;document.getElementById(id+'Val').textContent='0'+(id==='hue'?'°':'')});
  document.getElementById('saturation').value=1;document.getElementById('saturationVal').textContent='1';
  document.getElementById('gamma').value=1;document.getElementById('gammaVal').textContent='1';
}

// Bitrate estimate
function updateEstimate(){
  const crf=parseInt(document.getElementById('crfRange').value);
  const resVal=document.getElementById('res').value;
  const [w,h]=resVal.split('x').map(Number);
  const px=w*h;
  const dur=(videoDuration>0?(trimEndRatio-trimStartRatio)*videoDuration:60);
  const baseBitrate=Math.round((px/1920/1080)*(55-crf*1.8)*100)/100;
  const audioBps=parseInt(document.getElementById('abitrate').value);
  const totalMbps=baseBitrate+audioBps/1000;
  const estBytes=totalMbps*1e6/8*dur;

  const maxRef=30;
  document.getElementById('bfVideo').style.width=Math.min(100,baseBitrate/maxRef*100)+'%';
  document.getElementById('bnVideo').textContent=baseBitrate.toFixed(1)+' Mbps';
  document.getElementById('bfAudio').style.width=Math.min(100,audioBps/320*100)+'%';
  document.getElementById('bnAudio').textContent=audioBps/1000+' Mbps';
  document.getElementById('bfSize').style.width=Math.min(100,estBytes/500e6*100)+'%';
  document.getElementById('bnSize').textContent=fmt(estBytes);
}

// Log toggle
function toggleLog(){
  logEl.classList.toggle('open');
  document.querySelector('.log-toggle').textContent=logEl.classList.contains('open')?'▼ hide ffmpeg log':'▶ show ffmpeg log';
}

// Load FFmpeg
async function loadFFmpeg(){
  if(ffmpeg)return;
  ffmpeg=new FFmpeg();
  const base='https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/umd';
  ffmpeg.on('log',({message})=>{
    logEl.textContent+=message+'\n';
    logEl.scrollTop=logEl.scrollHeight;
    const m=message.match(/time=(\d+):(\d+):([\d.]+)/);
    if(m&&videoDuration>0){
      const t=parseInt(m[1])*3600+parseInt(m[2])*60+parseFloat(m[3]);
      const clipDur=(trimEndRatio-trimStartRatio)*videoDuration;
      if(clipDur>0){
        const pct=Math.min(100,Math.round(t/clipDur*100));
        bar.style.width=pct+'%';
        progPct.textContent=pct+'%';
        const elapsed=(Date.now()-encodeStartTime)/1000;
        const speed=t/Math.max(1,elapsed);
        encSpeedEl.textContent=speed.toFixed(1)+'x';
        if(speed>0)etaEl.textContent=fmtDur(Math.max(0,(clipDur-t)/speed));
      }
    }
    const speedM=message.match(/speed=\s*([\d.]+)x/);
    if(speedM)encSpeedEl.textContent=speedM[1]+'x';
  });
  await ffmpeg.load({
    coreURL:await toBlobURL(base+'/ffmpeg-core.js','text/javascript'),
    wasmURL:await toBlobURL(base+'/ffmpeg-core.wasm','application/wasm'),
  });
}

// Cancel
cancelBtn.addEventListener('click',()=>{
  cancelled=true;
  if(ffmpeg)ffmpeg.terminate();
  ffmpeg=null;
  cancelled=false;
  progLabel.textContent='Cancelled';
  encodeBtn.disabled=false;
  cancelBtn.style.display='none';
});

// Encode
encodeBtn.addEventListener('click',async()=>{
  if(!videoFile){alert('Please select a video first.');return}
  encodeBtn.disabled=true;
  cancelBtn.style.display='inline-flex';
  doneArea.classList.add('hidden');
  dlLink.classList.add('hidden');
  doneBadge.classList.add('hidden');
  progressArea.classList.remove('hidden');
  bar.style.width='0';
  bar.classList.remove('done');
  logEl.textContent='';
  progLabel.textContent='Loading encoder…';
  progPct.textContent='0%';
  encodeStartTime=Date.now();
  clearInterval(elapsedTimer);
  elapsedTimer=setInterval(()=>{elapsedEl.textContent=Math.round((Date.now()-encodeStartTime)/1000)+'s'},1000);

  try{
    await loadFFmpeg();
    progLabel.textContent='Writing source…';

    const resVal=document.getElementById('res').value;
    const [w,h]=resVal.split('x');
    const crf=document.getElementById('crfRange').value;
    const codec=document.getElementById('codec').value;
    const presetVal=document.getElementById('preset').value;
    const fpsVal=document.getElementById('fps').value;
    const acodec=document.getElementById('acodec').value;
    const abitrate=document.getElementById('abitrate').value;
    const samplerate=document.getElementById('samplerate').value;
    const vol=parseInt(document.getElementById('volRange').value);
    const brightness=parseFloat(document.getElementById('brightness').value);
    const contrast=parseFloat(document.getElementById('contrast').value);
    const saturation=parseFloat(document.getElementById('saturation').value);
    const gamma=parseFloat(document.getElementById('gamma').value);
    const hue=parseFloat(document.getElementById('hue').value);
    const sharpen=parseFloat(document.getElementById('sharpen').value);
    const denoise=parseFloat(document.getElementById('denoise').value);
    const stabilize=document.getElementById('stabilize').value;
    const profile=document.getElementById('profile').value;
    const level=document.getElementById('level').value;
    const pixfmt=document.getElementById('pixfmt').value;
    const maxBitrate=parseInt(document.getElementById('maxBitrate').value);
    const bufSize=parseInt(document.getElementById('bufSize').value);

    const ext=videoFile.name.slice(videoFile.name.lastIndexOf('.'));
    const inName='input'+ext;
    const outName='output_tiktok.mp4';

    await ffmpeg.writeFile(inName,await fetchFile(videoFile));

    // Build video filter chain
    const vfParts=[];
    vfParts.push(`scale=${w}:${h}:force_original_aspect_ratio=decrease`);
    vfParts.push(`pad=${w}:${h}:(ow-iw)/2:(oh-ih)/2`);
    if(brightness!==0||contrast!==0||saturation!==1||gamma!==1)
      vfParts.push(`eq=brightness=${brightness}:contrast=${1+contrast}:saturation=${saturation}:gamma=${gamma}`);
    if(hue!==0) vfParts.push(`hue=h=${hue}`);
    if(sharpen>0) vfParts.push(`unsharp=5:5:${sharpen}:5:5:0`);
    if(denoise>0) vfParts.push(`hqdn3d=${denoise}:${denoise}:${denoise*3}:${denoise*3}`);
    if(stabilize==='deshake') vfParts.push('deshake');

    // Build audio filter chain
    const afParts=[];
    if(vol!==100) afParts.push(`volume=${vol/100}`);

    const args=['-i',inName];

    // Trim
    const tStart=trimStartRatio*videoDuration;
    const tEnd=trimEndRatio*videoDuration;
    if(tStart>0){args.push('-ss',tStart.toFixed(3))}
    if(trimEndRatio<1){args.push('-to',tEnd.toFixed(3))}

    // FPS
    if(fpsVal!=='source') vfParts.push(`fps=${fpsVal}`);

    args.push('-vf',vfParts.join(','));
    args.push('-c:v',codec);
    if(codec!=='copy'){
      args.push('-preset',presetVal,'-crf',crf);
      if(codec==='libx264'){args.push('-profile:v',profile,'-level',level)}
      args.push('-pix_fmt',pixfmt,'-movflags','+faststart');
      if(maxBitrate>0){args.push('-maxrate',maxBitrate+'k','-bufsize',(bufSize||maxBitrate*2)+'k')}
    }
    if(acodec==='copy'){
      args.push('-c:a','copy');
    } else {
      args.push('-c:a',acodec,'-b:a',abitrate,'-ar',samplerate);
      if(afParts.length>0) args.push('-af',afParts.join(','));
    }
    args.push(outName);

    progLabel.textContent='Encoding…';
    await ffmpeg.exec(args);

    const data=await ffmpeg.readFile(outName);
    const blob=new Blob([data.buffer],{type:'video/mp4'});
    const url=URL.createObjectURL(blob);
    dlLink.href=url;
    dlLink.download='tiktok_'+videoFile.name.replace(/\.[^.]+$/,'')+'.mp4';

    bar.style.width='100%';
    bar.classList.add('done');
    progPct.textContent='100%';
    progLabel.textContent='Complete!';

    // Summary
    origSize.textContent=fmt(videoFile.size);
    newSize.textContent=fmt(blob.size);
    const diff=((blob.size-videoFile.size)/videoFile.size*100).toFixed(1);
    sizeChange.textContent=(diff>0?'+':'')+diff+'%';
    sizeChange.className='size-change '+(blob.size<videoFile.size?'smaller':'bigger');
    const totalElapsed=Math.round((Date.now()-encodeStartTime)/1000);
    encodeSummary.innerHTML=`
      <div class="summary-row"><span class="summary-key">Resolution</span><span class="summary-val">${w}×${h}</span></div>
      <div class="summary-row"><span class="summary-key">Codec</span><span class="summary-val">${codec}</span></div>
      <div class="summary-row"><span class="summary-key">CRF</span><span class="summary-val">${crf}</span></div>
      <div class="summary-row"><span class="summary-key">Preset</span><span class="summary-val">${presetVal}</span></div>
      <div class="summary-row"><span class="summary-key">Audio</span><span class="summary-val">${acodec==='copy'?'copy':abitrate}</span></div>
      <div class="summary-row"><span class="summary-key">Encode time</span><span class="summary-val">${totalElapsed}s</span></div>
    `;
    doneArea.classList.remove('hidden');
    dlLink.classList.remove('hidden');
    doneBadge.classList.remove('hidden');
  } catch(e){
    if(!cancelled){
      progLabel.textContent='Error — see log';
      logEl.textContent+='\n'+e.toString();
      logEl.classList.add('open');
    }
  }
  clearInterval(elapsedTimer);
  encodeBtn.disabled=false;
  cancelBtn.style.display='none';
});

// Init estimate
updateEstimate();
</script>
</body>
